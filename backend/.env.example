# Backend environment variables. Copy this file to `.env` and fill in values.
# Never commit the real `.env`. See the README "Environment Variables" section

# Runtime
NODE_ENV=development
PORT=8000
BASE_PATH=/api

# Database
# MongoDB connection string. Must be a replica set (Atlas works) so that
# multi-document transactions used during registration/OAuth/deletes succeed.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority

# Auth (JWT)
# Generate a strong secret:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# Session (reserved; the session layer is currently disabled)
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_EXPIRES_IN=1d

# Google OAuth (required only if Google sign-in is enabled)
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_CALLBACK_URL=http://localhost:8000/api/auth/google/callback

# API documentation
# Serves Swagger UI at `${BASE_PATH}/docs` and the OpenAPI document at
# `${BASE_PATH}/docs/openapi.json`. Set to `false` to stop serving both.
ENABLE_API_DOCS=true

# Frontend integration
# Comma-separated list of allowed CORS origins (no trailing slash).
FRONTEND_ORIGIN=http://localhost:5173
# SPA route that receives the OAuth token after a successful Google login.
FRONTEND_GOOGLE_CALLBACK_URL=http://localhost:5173/google/oauth/callback
